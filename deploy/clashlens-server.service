[Unit]
Description=ClashLens Central Traffic Analytics Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/clashlens
ExecStart=/opt/clashlens/clashlens-server-linux-amd64 -addr :8080 -db /opt/clashlens/data/clashlens.db
Environment="CLASHLENS_TZ_OFFSET=480"
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
