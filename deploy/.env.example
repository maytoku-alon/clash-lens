# ClashLens Server 环境变量示例（复制为 .env 使用，请勿将真实密钥提交到 Git）

# HTTP 监听地址与端口
CLASHLENS_ADDR=:8080

# SQLite 数据库存储路径
CLASHLENS_DB=/data/clashlens.db

# 时区偏移（分钟），东八区为 480
CLASHLENS_TZ_OFFSET=480
TZ=Asia/Shanghai

# 设备离线判断阈值（秒）
CLASHLENS_ONLINE_THRESHOLD_SEC=30

# 可选：首次启动自动设置的管理员密码（若不设置则首次打开 Web 大屏时在页面引导设置）
# CLASHLENS_ADMIN_PASSWORD=change-this-to-a-strong-password

# 可选：固定用于签名登录 Cookie 的随机密钥（不填则首次启动自动生成并持久化到 SQLite）
# CLASHLENS_SESSION_SECRET=replace-with-64-hex-chars

# Linux 容器热更新二进制文件监听开关（默认在 Linux 下开启）
CLASHLENS_WATCH_BINARY=true
